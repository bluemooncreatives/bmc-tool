# Template for .env — copy to .env and fill in. Never put real values here.
#
# Only NEXT_PUBLIC_* values are sent to the browser. Everything else stays
# server-side, so keep secrets un-prefixed.

# --- Server-only secrets -----------------------------------------------------

# MongoDB Atlas connection string. Include the database name in the path:
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/bmc_tool?retryWrites=true&w=majority
MONGODB_URI=

# OpenAI API key (sk-...).
OPENAI_API_KEY=

# Signs and verifies JWTs. Rotating this invalidates every session.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# --- Public (inlined into the client bundle) ---------------------------------

# Optional: enables the Clerk demonstration routes under /clerk.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
