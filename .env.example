# Template for .env — copy to .env and fill in. Never put real values here.
#
# Only NEXT_PUBLIC_* values are sent to the browser. Everything else stays
# server-side, so keep secrets un-prefixed.

# --- Server-only secrets -----------------------------------------------------

# MongoDB Atlas connection string. Include the database name in the path:
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/bmc_tool?retryWrites=true&w=majority
MONGODB_URI=

# OpenAI API key (sk-...).
OPENAI_API_KEY=

# Signs and verifies JWTs. Rotating this invalidates every session.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Permanent workspace owner. The default is shown here explicitly for clarity.
# On first database access this account is created (or upgraded) as the
# protected superadmin and email MFA is always enforced for it.
SUPERADMIN_EMAIL=contact.bluemooncreatives@gmail.com

# Optional one-time bootstrap password. It is only applied when the owner is
# first inserted. If omitted, use "Reset password" to establish a password.
SUPERADMIN_PASSWORD=

# Gmail SMTP through Nodemailer. Generate an App Password in the Google account
# after enabling 2-Step Verification; do not use the normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contact.bluemooncreatives@gmail.com
SMTP_PASSWORD=
MAIL_FROM=Blue Moon Creatives <contact.bluemooncreatives@gmail.com>

# Public origin used by server-generated links, e.g. the "Sign in" button in
# invite and password-reset emails (no trailing slash).
#
# On Vercel this is inferred automatically from the deployment (the project's
# production domain on production, the deployment URL on previews), so it only
# needs to be set when the app is served from a custom domain or hosted
# elsewhere. In production, no value and no Vercel inference is a hard error
# rather than a silent fall back to localhost.
APP_URL=http://localhost:3000

# Optional, comma separated. Extra origins the app is legitimately served from
# (custom domains, staging aliases). Emails link back to whichever of these the
# administrator was actually using; anything not listed falls back to APP_URL,
# so a forged Host header cannot redirect an invite to a look-alike domain.
APP_ORIGINS=

# --- Public (inlined into the client bundle) ---------------------------------

# Optional: enables the Clerk demonstration routes under /clerk.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
